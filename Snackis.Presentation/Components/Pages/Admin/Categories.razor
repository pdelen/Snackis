@page "/admin/categories"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Snackis.Application.Interfaces
@using Snackis.Domain.Entities

@inject IForumCategoryService CategoryService

<PageTitle>Admin - Kategorier</PageTitle>

<h1>Kategorier</h1>

@if (_topLevelCategories is null)
{
    <p>Laddar...</p>
}
else if (_topLevelCategories.Count == 0)
{
    <p>Inga kategorier ännu.</p>
}
else
{
    @foreach (var category in _topLevelCategories)
    {
        <div class="mb-4">
            <div class="d-flex align-items-center gap-2">
                @if (_editingCategoryId == category.Id)
                {
                    <input class="form-control w-auto" @bind="_editingCategoryName" />
                    <button class="btn btn-sm btn-success" @onclick="() => SaveCategoryEdit(category)">Spara</button>
                    <button class="btn btn-sm btn-secondary" @onclick="CancelCategoryEdit">Avbryt</button>
                }
                else
                {
                    <h4 class="mb-0">@category.Name</h4>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartCategoryEdit(category)">Redigera</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCategory(category.Id)">Ta bort</button>
                }
            </div>

            @if (category.SubCategories.Count == 0)
            {
                <p class="text-muted ms-4 mb-0">Inga underämnen ännu.</p>
            }
            else
            {
                <ul class="list-group ms-4 mb-2">
                    @foreach (var sub in category.SubCategories)
                    {
                        <li class="list-group-item d-flex align-items-center gap-2">
                            @if (_editingCategoryId == sub.Id)
                            {
                                <input class="form-control w-auto" @bind="_editingCategoryName" />
                                <button class="btn btn-sm btn-success" @onclick="() => SaveCategoryEdit(sub)">Spara</button>
                                <button class="btn btn-sm btn-secondary" @onclick="CancelCategoryEdit">Avbryt</button>
                            }
                            else
                            {
                                <a href="../category/@sub.Id">@sub.Name</a>
                                <span class="text-muted small">(@sub.Posts.Count inlägg)</span>
                                <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => StartCategoryEdit(sub)">Redigera</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCategory(sub.Id)">Ta bort</button>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
}

<h4>Skapa kategori</h4>
<EditForm Model="_newCategory" OnSubmit="CreateCategory" FormName="CreateCategory" class="row g-2 align-items-end mb-4">
    <DataAnnotationsValidator />
    <div class="col-auto">
        <InputText @bind-Value="_newCategory.Name" class="form-control" placeholder="Namn på kategori" />
    </div>
    <div class="col-auto">
        <InputSelect @bind-Value="_newCategory.ParentCategoryId" class="form-select">
            <option value="0">Huvudkategori</option>
            @foreach (var category in _topLevelCategories ?? [])
            {
                <option value="@category.Id">Underämne till @category.Name</option>
            }
        </InputSelect>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Skapa kategori</button>
    </div>
    <ValidationSummary />
</EditForm>

@code {
    private List<ForumCategory>? _topLevelCategories;
    private NewCategoryModel _newCategory = new();

    private int? _editingCategoryId;
    private string _editingCategoryName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        var categories = await CategoryService.GetAllCategoriesAsync();
        _topLevelCategories = categories.Where(c => c.ParentCategoryId is null).ToList();
    }

    private async Task CreateCategory(EditContext editContext)
    {
        if (!editContext.Validate())
        {
            return;
        }

        await CategoryService.SaveCategoryAsync(new ForumCategory
        {
            Name = _newCategory.Name,
            ParentCategoryId = _newCategory.ParentCategoryId == 0 ? null : _newCategory.ParentCategoryId
        });

        _newCategory = new NewCategoryModel();
        await LoadCategories();
    }

    private void StartCategoryEdit(ForumCategory category)
    {
        _editingCategoryId = category.Id;
        _editingCategoryName = category.Name;
    }

    private void CancelCategoryEdit()
    {
        _editingCategoryId = null;
    }

    private async Task SaveCategoryEdit(ForumCategory category)
    {
        category.Name = _editingCategoryName;
        await CategoryService.EditCategoryAsync(category);
        _editingCategoryId = null;
        await LoadCategories();
    }

    private async Task DeleteCategory(int categoryId)
    {
        await CategoryService.DeleteCategoryAsync(categoryId);
        await LoadCategories();
    }

    private class NewCategoryModel
    {
        [Required(ErrorMessage = "Namn är obligatoriskt")]
        public string Name { get; set; } = "";

        public int ParentCategoryId { get; set; }
    }
}
