@page "/"

@using Snackis.Application.Interfaces
@using Snackis.Domain.Entities

@inject IForumCategoryService CategoryService

<PageTitle>Snackis - Forum</PageTitle>

<h1>Snackis</h1>

@if (_topLevelCategories is null)
{
    <p>Laddar...</p>
}
else if (_topLevelCategories.Count == 0)
{
    <p>Inga kategorier har skapats ännu.</p>
}
else
{
    <ul class="list-group">
        @foreach (var category in _topLevelCategories)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a href="category/@category.Id">@category.Name</a>
                <span class="text-muted small">@category.SubCategories.Count ämne(n)</span>
            </li>
        }
    </ul>
}

@code {
    private List<ForumCategory>? _topLevelCategories;

    protected override async Task OnInitializedAsync()
    {
        var categories = await CategoryService.GetAllCategoriesAsync();
        _topLevelCategories = categories.Where(c => c.ParentCategoryId is null).ToList();
    }
    
}
