@page "/Account/Profile"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Identity
@using Snackis.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IWebHostEnvironment Environment

<PageTitle>Min profil</PageTitle>

<h1>Min profil</h1>

@if (_currentUser is null)
{
    <p>Laddar...</p>
}
else
{
    <div class="mb-3">
        @if (!string.IsNullOrEmpty(_currentUser.ProfileImageUrl))
        {
            <img src="@_currentUser.ProfileImageUrl" alt="Profilbild" class="profile-image-preview" />
        }
        else
        {
            <p class="text-muted">Ingen profilbild uppladdad ännu.</p>
        }
    </div>

    <InputFile OnChange="OnFileSelected" accept=".jpg,.jpeg,.png" />

    @if (_errorMessage is not null)
    {
        <p class="text-danger mt-2">@_errorMessage</p>
    }
    @if (_successMessage is not null)
    {
        <p class="text-success mt-2">@_successMessage</p>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ApplicationUser? _currentUser;
    private string? _errorMessage;
    private string? _successMessage;

    private static readonly string[] AllowedExtensions = [".jpg", ".jpeg", ".png"];
    private const long MaxFileSizeBytes = 2 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        _currentUser = await UserManager.GetUserAsync(authState.User);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _successMessage = null;

        if (_currentUser is null)
        {
            return;
        }

        var file = e.File;
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!AllowedExtensions.Contains(extension))
        {
            _errorMessage = "Endast JPG och PNG-bilder är tillåtna.";
            return;
        }

        if (file.Size > MaxFileSizeBytes)
        {
            _errorMessage = "Bilden får max vara 2 MB.";
            return;
        }

        var uploadsFolder = Path.Combine(Environment.WebRootPath, "uploads", "profiles");
        Directory.CreateDirectory(uploadsFolder);

        var fileName = $"{_currentUser.Id}{extension}";
        var filePath = Path.Combine(uploadsFolder, fileName);

        await using (var stream = new FileStream(filePath, FileMode.Create))
        {
            await file.OpenReadStream(MaxFileSizeBytes).CopyToAsync(stream);
        }

        _currentUser.ProfileImageUrl = $"/uploads/profiles/{fileName}";
        await UserManager.UpdateAsync(_currentUser);

        _successMessage = "Profilbilden har uppdaterats.";
    }
}
